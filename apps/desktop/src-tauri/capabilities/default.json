{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege permissions for the main window: window chrome control plus Parlance's own commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-always-on-top",
    "allow-app-info",
    "allow-list-sources",
    "allow-get-settings",
    "allow-update-settings",
    "allow-list-models",
    "allow-download-model",
    "allow-cancel-download",
    "allow-subscribe",
    "allow-session-state",
    "allow-start-session",
    "allow-stop-session",
    "allow-pause-session",
    "allow-resume-session",
    "allow-list-history",
    "allow-history-transcript",
    "allow-delete-history"
  ]
}

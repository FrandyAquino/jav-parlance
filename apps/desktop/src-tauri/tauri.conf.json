{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parlance",
  "version": "0.1.0",
  "identifier": "app.parlance.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Parlance",
        "width": 820,
        "height": 560,
        "minWidth": 440,
        "minHeight": 320,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": true,
        "resizable": true,
        "windowEffects": {
          "effects": [
            "acrylic",
            "blur",
            "hudWindow"
          ],
          "state": "active",
          "radius": 14
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../src/assets/fonts/OFL.txt": "licenses/google-sans-flex/OFL.txt",
      "../src/assets/fonts/TRADEMARKS.md": "licenses/google-sans-flex/TRADEMARKS.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}

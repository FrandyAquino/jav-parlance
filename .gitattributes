# Normalize text to LF in the repo and working tree on every OS, so generated
# bindings and lockfiles do not show spurious line-ending diffs in CI.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.png binary
*.ico binary
*.icns binary
*.wav binary
*.gguf binary
*.bin binary
*.zip binary
